NODE_ENV=development
PORT=3100
WEB_ORIGIN=http://localhost:5173,http://localhost:5175
COOKIE_SECURE=false
DATABASE_URL=postgresql://flux:flux_dev_password@localhost:5432/flux_studio?schema=public
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_DAYS=30
OTP_TTL_MINUTES=10
GLOBAL_RATE_LIMIT=600
# Development can be more permissive; use 8 or lower in production.
ADMIN_LOGIN_RATE_LIMIT=30
UPLOAD_DIR=uploads
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
ADMIN_EMAIL=xinyue@xinyue.mom
# Initial administrator password. Change it in the admin console after first login.
ADMIN_PASSWORD=xinyue.mom
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=
AI_CHAT_MODEL=gpt-4.1
AI_IMAGE_MODEL=gpt-image-1
# Optional: outbound proxy used by remote prompt-library synchronization.
HTTPS_PROXY=
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-different-32-character-secret
