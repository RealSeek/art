# Required by the PostgreSQL container and Docker Compose interpolation.
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://flux:${POSTGRES_PASSWORD}@postgres:5432/flux_studio?schema=public
REDIS_URL=redis://redis:6379
# Replace with the final HTTPS origin before opening the service to users.
WEB_ORIGIN=http://localhost
COOKIE_SECURE=false
SESSION_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-different-32-character-secret
GLOBAL_RATE_LIMIT=600
ADMIN_LOGIN_RATE_LIMIT=8
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_DISPLAY_NAME=超级管理员
# Set true for one restart only when intentionally rotating the seeded administrator password.
ADMIN_FORCE_PASSWORD_RESET=false
# File storage. Keep UPLOAD_DIR mounted even after enabling S3 until all legacy local assets are migrated.
UPLOAD_DIR=/app/uploads
STORAGE_DRIVER=local
# S3-compatible storage (AWS S3, Cloudflare R2, MinIO, OSS gateway, etc.).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Safe lifecycle rules managed by Xinyue. Active asset objects are never expired automatically.
S3_ABORT_INCOMPLETE_UPLOAD_DAYS=7
S3_NONCURRENT_EXPIRATION_DAYS=30

# Optional isolated image-tools Worker. Keep this token secret when the Worker is reachable outside a trusted Docker network.
LOCAL_WORKER_TOKEN=
LOCAL_WORKER_CONCURRENCY=1
LOCAL_WORKER_RESULT_TTL_SECONDS=604800
LOCAL_WORKER_REMBG_MODEL=u2net
LOCAL_WORKER_IOPAINT_MODEL=lama
LOCAL_WORKER_IOPAINT_DEVICE=cpu
LOCAL_WORKER_REALESRGAN_DEVICE=cpu
LOCAL_WORKER_REALESRGAN_TILE=0
COMFYUI_URL=http://comfyui:8188
COMFYUI_TIMEOUT_SECONDS=600
COMFYUI_WORKFLOW_DIR=./workers/comfyui-gateway/workflows
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=
